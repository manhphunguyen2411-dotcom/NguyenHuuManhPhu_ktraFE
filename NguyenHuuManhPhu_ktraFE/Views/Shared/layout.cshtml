    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        amazon_blue: {
                            light: '#232f3e',
                            DEFAULT: '#131921',
                        },
                        amazon_yellow: {
                            DEFAULT: '#febd69',
                            dark: '#f0c14b',
                            btn: '#ffd814'
