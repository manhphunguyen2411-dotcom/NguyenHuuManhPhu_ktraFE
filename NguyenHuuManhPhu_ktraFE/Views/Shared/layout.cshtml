            border-color: #ff8f00;
        }

            .amazon-btn-orange:hover {
                background-color: #fa8900;
            }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
